 import tempfile
+import sqlite3
 import unittest
 from pathlib import Path
-from provider import Provider
+from provider import LostReply, Provider
 from settlement import Settlement
 
 class SettlementTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.reopen()
+
+    def reopen(self):
+        self.provider = Provider(self.root / 'provider.db')
+        self.service = Settlement(self.root / 'service.db', self.provider)
+        self.addCleanup(self.provider.close)
+        self.addCleanup(self.service.close)
+
+    def transfers(self):
+        return self.provider.db.execute('SELECT id, cents FROM transfers ORDER BY id').fetchall()
+
+    def test_lost_reply_retries_after_reopen(self):
+        self.provider.drop_next_reply = True
+        with self.assertRaises(LostReply):
+            self.service.settle('uncertain', 3500)
+        original = self.transfers()
+        self.assertEqual(len(original), 1)
+        self.service.close()
+        self.provider.close()
+        self.reopen()
+        with self.assertRaises(ValueError):
+            self.service.settle('uncertain', 3501)
+        self.assertEqual(original, self.transfers())
+        self.assertEqual(original[0][0], self.service.settle('uncertain', 3500))
+        self.assertEqual(original[0][0], self.service.settle('uncertain', 3500))
+        self.assertEqual(original, self.transfers())
+
+    def test_lost_reply_retries_without_reopen(self):
+        self.provider.drop_next_reply = True
+        with self.assertRaises(LostReply):
+            self.service.settle('uncertain', 3500)
+        original = self.transfers()
+        self.assertEqual(original[0][0], self.service.settle('uncertain', 3500))
+        self.assertEqual(original, self.transfers())
+
+    def test_completed_amount_is_fixed_and_fresh_id_is_independent(self):
+        first = self.service.settle('first', 3500)
+        self.service.close()
+        self.provider.close()
+        self.reopen()
+        self.assertEqual(first, self.service.settle('first', 3500))
+        with self.assertRaises(ValueError):
+            self.service.settle('first', 3501)
+        second = self.service.settle('second', 3500)
+        self.assertNotEqual(first, second)
+        self.assertEqual([(first, 3500), (second, 3500)], self.transfers())
+
+    def test_existing_completed_database_is_preserved(self):
+        path = self.root / 'legacy.db'
+        transfer_id = self.provider.transfer('old-random-request-key', 4200)
+        with sqlite3.connect(path) as db:
+            db.execute('CREATE TABLE completed (settlement_id TEXT PRIMARY KEY, cents INTEGER NOT NULL, transfer_id INTEGER NOT NULL)')
+            db.execute('INSERT INTO completed VALUES (?, ?, ?)', ('legacy', 4200, transfer_id))
+        legacy = Settlement(path, self.provider)
+        self.addCleanup(legacy.close)
+        self.assertEqual(transfer_id, legacy.settle('legacy', 4200))
+        with self.assertRaises(ValueError):
+            legacy.settle('legacy', 4201)
+        self.assertEqual([(transfer_id, 4200)], self.transfers())
+
